# Reference list of every value you must replace. These are NOT read automatically:
# paste each one into n8n credentials/nodes or the Retell dashboard as described in docs/SETUP.md.

# Shared secret between Retell and n8n (Header Auth, header name: x-api-key)
WEBHOOK_API_KEY=YOUR_WEBHOOK_API_KEY

# n8n
N8N_BASE_URL=https://n8n.your-domain.com
# Production webhook paths, one per workflow
WEBHOOK_PATH_CHECK_AVAILABILITY=retell-check-availability
WEBHOOK_PATH_BOOK_APPOINTMENT=retell-book-appointment
WEBHOOK_PATH_FIND_APPOINTMENT=retell-find-appointment
WEBHOOK_PATH_RESCHEDULE_APPOINTMENT=retell-reschedule-appointment
WEBHOOK_PATH_CANCEL_APPOINTMENT=retell-cancel-appointment
WEBHOOK_PATH_LOG_CALL=retell-log-call

# Google
GOOGLE_CALENDAR_ID=YOUR_GOOGLE_CALENDAR_ID@group.calendar.google.com
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID
GOOGLE_CALL_LOG_SHEET_GID=YOUR_CALL_LOG_SHEET_GID

# Retell
RETELL_AGENT_ID=YOUR_RETELL_AGENT_ID
RETELL_CONVERSATION_FLOW_ID=YOUR_CONVERSATION_FLOW_ID
FRONT_DESK_PHONE_E164=+920000000000
